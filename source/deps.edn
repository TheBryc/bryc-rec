{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.1"}
  org.clojure/clojurescript {:mvn/version "1.12.42"}
  com.pitch/uix.core {:mvn/version "1.4.4"}
  com.pitch/uix.dom {:mvn/version "1.4.4"}}
 ;; Trimmed for the rec-live build: only the deps the rec-demo prototype
 ;; namespaces need (uix + cljs). The app-only deps (reitit, si-frame,
 ;; poly/riasec local lib, grain) are not on this build's classpath.
 :aliases
 {:dev {:extra-deps
        {thheller/shadow-cljs {:mvn/version "3.2.0"}
         binaryage/devtools {:mvn/version "1.0.7"}}}
  :test {:extra-paths ["test"]}}}
